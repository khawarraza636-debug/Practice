<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Khawar Raza Academy</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

    <style>

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: "Poppins", sans-serif;
            color: #172033;
            background: #ffffff;
            line-height: 1.6;
        }

        /* ================= NAVBAR ================= */

        header {
            width: 100%;
            background: #ffffff;
            box-shadow: 0 2px 15px rgba(0, 0, 0, 0.06);
            position: sticky;
            top: 0;
            z-index: 1000;
        }

        .navbar {
            max-width: 1200px;
            margin: auto;
            padding: 18px 25px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .logo {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .logo > span {
            width: 48px;
            height: 48px;
            background: #155eef;
            color: white;
            border-radius: 12px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-weight: 800;
        }

        .logo h2 {
            font-size: 18px;
            line-height: 1.1;
        }

        .logo small {
            color: #155eef;
        }

        .nav-links {
            display: flex;
            gap: 30px;
            list-style: none;
        }

        .nav-links a {
            color: #172033;
            text-decoration: none;
            font-size: 14px;
            font-weight: 500;
        }

        .nav-links a:hover {
            color: #155eef;
        }

        .nav-btn,
        .btn {
            text-decoration: none;
            display: inline-block;
            border-radius: 8px;
            padding: 12px 22px;
            font-weight: 600;
            transition: 0.3s;
        }

        .nav-btn {
            background: #155eef;
            color: white;
        }

        .nav-btn:hover {
            background: #0b4dcc;
        }

        /* ================= HERO ================= */

        .hero {
            min-height: 650px;
            padding: 90px 8%;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 60px;
            background: linear-gradient(135deg, #f4f8ff, #ffffff);
        }

        .hero-content {
            max-width: 620px;
        }

        .welcome,
        .section-tag {
            color: #155eef;
            font-size: 13px;
            font-weight: 700;
            letter-spacing: 1.5px;
        }

        .hero h1 {
            margin: 18px 0;
            font-size: 58px;
            line-height: 1.15;
            font-weight: 800;
        }

        .hero h1 span {
            color: #155eef;
        }

        .hero p {
            max-width: 560px;
            color: #657084;
            font-size: 17px;
            margin-bottom: 30px;
        }

        .hero-buttons {
            display: flex;
            gap: 15px;
        }

        .primary {
            background: #155eef;
            color: white;
        }

        .primary:hover {
            background: #0b4dcc;
            transform: translateY(-2px);
        }

        .secondary {
            border: 1px solid #d6dce8;
            color: #172033;
        }

        .secondary:hover {
            border-color: #155eef;
            color: #155eef;
        }

        .hero-card {
            width: 400px;
            min-height: 430px;
            border-radius: 25px;
            padding: 45px 35px;
            background: #155eef;
            color: white;
            text-align: center;
            position: relative;
            overflow: hidden;
            box-shadow: 0 25px 60px rgba(21, 94, 239, 0.25);
        }

        .circle {
            width: 260px;
            height: 260px;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.1);
            position: absolute;
            top: -100px;
            right: -80px;
        }

        .student-icon {
            font-size: 80px;
            margin: 25px 0;
            position: relative;
        }

        .hero-card h3 {
            font-size: 25px;
        }

        .hero-card > p {
            margin: 10px 0 30px;
            opacity: 0.9;
        }

        .stats {
            display: flex;
            justify-content: space-around;
            border-top: 1px solid rgba(255,255,255,0.25);
            padding-top: 25px;
        }

        .stats div {
            display: flex;
            flex-direction: column;
        }

        .stats strong {
            font-size: 22px;
        }

        .stats span {
            font-size: 12px;
            opacity: 0.8;
        }

        /* ================= ABOUT ================= */

        .about {
            max-width: 1200px;
            margin: auto;
            padding: 100px 25px;
            display: grid;
            grid-template-columns: 1fr 1fr;
            align-items: center;
            gap: 80px;
        }

        .about-image {
            height: 420px;
            border-radius: 25px;
            background: linear-gradient(145deg, #dbe8ff, #eef4ff);
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .about-box {
            background: white;
            width: 280px;
            padding: 40px 25px;
            border-radius: 20px;
            text-align: center;
            box-shadow: 0 20px 50px rgba(0, 0, 0, 0.08);
        }

        .about-box span {
            font-size: 60px;
        }

        .about-box h3 {
            margin: 10px 0;
        }

        .about-box p {
            color: #657084;
        }

        .about-content h2 {
            font-size: 40px;
            line-height: 1.2;
            margin: 15px 0 20px;
        }

        .about-content p {
            color: #657084;
            margin-bottom: 15px;
        }

        /* ================= COURSES ================= */

        .courses {
            background: #f7f9fc;
            padding: 100px 25px;
        }

        .section-heading {
            text-align: center;
            max-width: 700px;
            margin: 0 auto 50px;
        }

        .section-heading h2 {
            font-size: 38px;
            margin: 10px 0;
        }

        .section-heading p {
            color: #657084;
        }

        .course-container {
            max-width: 1200px;
            margin: auto;
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 20px;
        }

        .course-card {
            background: white;
            padding: 30px 25px;
            border-radius: 15px;
            border: 1px solid #e8ecf2;
            transition: 0.3s;
        }

        .course-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.08);
        }

        .course-icon {
            font-size: 45px;
            margin-bottom: 15px;
        }

        .course-card h3 {
            margin-bottom: 10px;
        }

        .course-card p {
            color: #657084;
            font-size: 14px;
            margin-bottom: 20px;
        }

        .course-card a {
            color: #155eef;
            text-decoration: none;
            font-weight: 600;
            font-size: 14px;
        }

        /* ================= FEATURES ================= */

        .why-us {
            padding: 100px 25px;
        }

        .features {
            max-width: 1100px;
            margin: auto;
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 25px;
        }

        .feature {
            text-align: center;
            padding: 25px;
        }

        .feature span {
            font-size: 45px;
        }

        .feature h3 {
            margin: 12px 0 8px;
        }

        .feature p {
            color: #657084;
            font-size: 14px;
        }

        /* ================= ADMISSION ================= */

        .admission {
            max-width: 1150px;
            margin: 20px auto 100px;
            padding: 55px 60px;
            border-radius: 20px;
            background: #155eef;
            color: white;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 30px;
        }

        .admission span {
            font-size: 12px;
            letter-spacing: 2px;
            font-weight: 700;
        }

        .admission h2 {
            font-size: 34px;
            margin: 8px 0;
        }

        .admission p {
            opacity: 0.9;
        }

        .white {
            background: white;
            color: #155eef;
        }

        .white:hover {
            background: #f0f4ff;
        }

        /* ================= CONTACT ================= */

        .contact {
            padding: 90px 25px;
            background: #f7f9fc;
        }

        .contact-container {
            max-width: 1000px;
            margin: auto;
            display: grid;
            grid-template-columns: 1fr 1.3fr;
            gap: 60px;
        }

        .contact-info h3 {
            font-size: 25px;
            margin-bottom: 25px;
        }

        .contact-info p {
            margin: 15px 0;
            color: #657084;
        }

        .socials {
            display: flex;
            gap: 15px;
            margin-top: 25px;
        }

        .socials a {
            text-decoration: none;
            color: #155eef;
            font-size: 14px;
            font-weight: 600;
        }

        .contact-form {
            display: flex;
            flex-direction: column;
            gap: 15px;
        }

        .contact-form input,
        .contact-form textarea {
            width: 100%;
            border: 1px solid #dce1e9;
            padding: 14px;
            border-radius: 8px;
            font-family: inherit;
            outline: none;
        }

        .contact-form input:focus,
        .contact-form textarea:focus {
            border-color: #155eef;
        }

        .contact-form button {
            border: none;
            background: #155eef;
            color: white;
            padding: 14px;
            border-radius: 8px;
            font-size: 15px;
            font-weight: 600;
            cursor: pointer;
        }

        .contact-form button:hover {
            background: #0b4dcc;
        }

        /* ================= FOOTER ================= */

        footer {
            background: #101828;
            color: white;
            padding: 35px 25px;
        }

        .footer-content {
            max-width: 1150px;
            margin: auto;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 20px;
        }

        .footer-content p {
            color: #98a2b3;
            font-size: 13px;
        }

        /* ================= RESPONSIVE ================= */

        @media (max-width: 900px) {

            .nav-links {
                display: none;
            }

            .hero {
                flex-direction: column;
                text-align: center;
                padding: 70px 25px;
            }

            .hero p {
                margin-left: auto;
                margin-right: auto;
            }

            .hero-buttons {
                justify-content: center;
            }

            .hero-card {
                width: 100%;
                max-width: 400px;
            }

            .about {
                grid-template-columns: 1fr;
            }

            .course-container,
            .features {
                grid-template-columns: repeat(2, 1fr);
            }

            .admission {
                margin-left: 25px;
                margin-right: 25px;
                flex-direction: column;
                text-align: center;
            }

            .contact-container {
                grid-template-columns: 1fr;
            }
        }

        @media (max-width: 600px) {

            .navbar {
                padding: 15px;
            }

            .nav-btn {
                display: none;
            }

            .hero h1 {
                font-size: 40px;
            }

            .hero-buttons {
                flex-direction: column;
            }

            .about-content h2,
            .section-heading h2 {
                font-size: 30px;
            }

            .course-container,
            .features {
                grid-template-columns: 1fr;
            }

            .about-image {
                height: 320px;
            }

            .admission {
                padding: 40px 25px;
            }

            .admission h2 {
                font-size: 28px;
            }

            .footer-content {
                flex-direction: column;
                text-align: center;
            }
        }

    </style>
</head>

<body>

    <!-- NAVBAR -->
    <header>
        <nav class="navbar">

            <div class="logo">
                <span>KRA</span>

                <div>
                    <h2>Khawar Raza</h2>
                    <small>Academy</small>
                </div>
            </div>

            <ul class="nav-links">
                <li><a href="#home">Home</a></li>
                <li><a href="#about">About</a></li>
                <li><a href="#courses">Courses</a></li>
                <li><a href="#why-us">Why Us</a></li>
                <li><a href="#contact">Contact</a></li>
            </ul>

            <a href="#admission" class="nav-btn">Get Admission</a>

        </nav>
    </header>


    <!-- HERO -->
    <section class="hero" id="home">

        <div class="hero-content">

            <span class="welcome">WELCOME TO OUR ACADEMY</span>

            <h1>
                Learn Today,<br>
                <span>Lead Tomorrow.</span>
            </h1>

            <p>
                Quality education, experienced teachers and a supportive
                learning environment to help students achieve their goals.
            </p>

            <div class="hero-buttons">
                <a href="#courses" class="btn primary">
                    Explore Courses
                </a>

                <a href="#contact" class="btn secondary">
                    Contact Us
                </a>
            </div>

        </div>


        <div class="hero-card">

            <div class="circle"></div>

            <div class="student-icon">🎓</div>

            <h3>Quality Education</h3>

            <p>
                Building knowledge, confidence and a brighter future.
            </p>

            <div class="stats">

                <div>
                    <strong>500+</strong>
                    <span>Students</span>
                </div>

                <div>
                    <strong>20+</strong>
                    <span>Teachers</span>
                </div>

                <div>
                    <strong>10+</strong>
                    <span>Courses</span>
                </div>

            </div>

        </div>

    </section>


    <!-- ABOUT -->
    <section class="about" id="about">

        <div class="about-image">

            <div class="about-box">

                <span>🎓</span>

                <h3>Education First</h3>

                <p>
                    Knowledge is the key to success.
                </p>

            </div>

        </div>


        <div class="about-content">

            <span class="section-tag">
                ABOUT OUR ACADEMY
            </span>

            <h2>
                We Help Students Build a Better Future
            </h2>

            <p>
                Khawar Raza Academy is committed to providing quality
                education through modern teaching methods and experienced
                teachers.
            </p>

            <p>
                Our goal is to create a positive learning environment where
                every student can improve their skills, confidence and
                academic performance.
            </p>

            <a href="#contact" class="btn primary">
                Learn More
            </a>

        </div>

    </section>


    <!-- COURSES -->
    <section class="courses" id="courses">

        <div class="section-heading">

            <span class="section-tag">
                OUR COURSES
            </span>

            <h2>
                Explore Our Popular Classes
            </h2>

            <p>
                Choose the right course and start your learning journey.
            </p>

        </div>


        <div class="course-container">

            <div class="course-card">

                <div class="course-icon">📚</div>

                <h3>School Classes</h3>

                <p>
                    Complete academic support for school students with
                    experienced teachers.
                </p>

                <a href="#">Learn More →</a>

            </div>


            <div class="course-card">

                <div class="course-icon">💻</div>

                <h3>Computer Course</h3>

                <p>
                    Learn basic computer skills, MS Office and essential
                    digital skills.
                </p>

                <a href="#">Learn More →</a>

            </div>


            <div class="course-card">

                <div class="course-icon">📖</div>

                <h3>English Language</h3>

                <p>
                    Improve grammar, vocabulary, speaking and communication
                    skills.
                </p>

                <a href="#">Learn More →</a>

            </div>


            <div class="course-card">

                <div class="course-icon">🧮</div>

                <h3>Mathematics</h3>

                <p>
                    Easy and practical mathematics learning from basic to
                    advanced levels.
                </p>

                <a href="#">Learn More →</a>

            </div>

        </div>

    </section>


    <!-- WHY CHOOSE US -->
    <section class="why-us" id="why-us">

        <div class="section-heading">

            <span class="section-tag">
                WHY CHOOSE US
            </span>

            <h2>
                What Makes Our Academy Different?
            </h2>

        </div>


        <div class="features">

            <div class="feature">

                <span>👨‍🏫</span>

                <h3>Expert Teachers</h3>

                <p>
                    Qualified and experienced teachers dedicated to students.
                </p>

            </div>


            <div class="feature">

                <span>🏫</span>

                <h3>Modern Environment</h3>

                <p>
                    A friendly and comfortable environment for learning.
                </p>

            </div>


            <div class="feature">

                <span>🎯</span>

                <h3>Student Focused</h3>

                <p>
                    Special attention to individual student needs.
                </p>

            </div>


            <div class="feature">

                <span>⭐</span>

                <h3>Better Results</h3>

                <p>
                    Focused learning designed to improve academic performance.
                </p>

            </div>

        </div>

    </section>


    <!-- ADMISSION -->
    <section class="admission" id="admission">

        <div>

            <span>START YOUR JOURNEY</span>

            <h2>
                Ready to Start Learning?
            </h2>

            <p>
                Join our academy today and take the next step toward success.
            </p>

        </div>

        <a href="#contact" class="btn white">
            Apply Now
        </a>

    </section>


    <!-- CONTACT -->
    <section class="contact" id="contact">

        <div class="section-heading">

            <span class="section-tag">
                CONTACT US
            </span>

            <h2>
                Get In Touch
            </h2>

        </div>


        <div class="contact-container">

            <div class="contact-info">

                <h3>
                    Contact Information
                </h3>

                <p>📍 Bahawalpur, Punjab, Pakistan</p>

                <p>📞 +92 300 0000000</p>

                <p>✉️ info@khawarrazacademy.com</p>


                <div class="socials">

                    <a href="#">Facebook</a>

                    <a href="#">Instagram</a>

                    <a href="#">YouTube</a>

                </div>

            </div>


            <form class="contact-form">

                <input
                    type="text"
                    placeholder="Your Name"
                    required
                >

                <input
                    type="email"
                    placeholder="Your Email"
                    required
                >

                <input
                    type="text"
                    placeholder="Subject"
                >

                <textarea
                    rows="5"
                    placeholder="Your Message"
                ></textarea>

                <button type="submit">
                    Send Message
                </button>

            </form>

        </div>

    </section>


    <!-- FOOTER -->
    <footer>

        <div class="footer-content">

            <div>

                <h2>Khawar Raza Academy</h2>

                <p>
                    Quality education for a brighter future.
                </p>

            </div>

            <div>

                <p>
                    © 2026 Khawar Raza Academy. All Rights Reserved.
                </p>

            </div>

        </div>

    </footer>

</body>
</html>
